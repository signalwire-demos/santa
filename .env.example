# SignalWire Credentials (required for automatic token/handler setup)
SIGNALWIRE_SPACE_NAME=your-space
SIGNALWIRE_PROJECT_ID=your-project-id
SIGNALWIRE_TOKEN=your-api-token

# Public URL SignalWire fetches the SWML from (POST {base}/santa).
# Required to register the handler and mint guest tokens — without it, /get_token
# returns 500. Use an ngrok/tunnel URL for local dev; SWML_PROXY_URL_BASE takes
# precedence over APP_URL (the Dokku/Heroku deployment fallback below).
SWML_PROXY_URL_BASE=https://your-tunnel.ngrok-free.app
APP_URL=https://your-app-url.com

# Agent Configuration
# Fabric resource name; the dialable address becomes /public/{AGENT_NAME}.
# Use a DISTINCT name (e.g. santa-dev) for local runs — startup UPDATES the URL of
# the handler with this name, so a shared name repoints other consumers.
AGENT_NAME=santa
SWML_BASIC_AUTH_USER=admin
SWML_BASIC_AUTH_PASSWORD=your-secure-password

# RapidAPI (for Amazon gift search; falls back to mock data if unset)
RAPIDAPI_KEY=your-rapidapi-key
# RAPIDAPI_HOST=real-time-amazon-data.p.rapidapi.com

# Optional gift knobs (defaults: 10.00 / 100.00 / 2025)
# MIN_GIFT_PRICE=10.00
# MAX_GIFT_PRICE=100.00
# CHRISTMAS_YEAR=2025

# Optional: Post-prompt webhook URL for conversation summaries
# POST_PROMPT_URL=https://your-webhook-url.com/santa/summary
